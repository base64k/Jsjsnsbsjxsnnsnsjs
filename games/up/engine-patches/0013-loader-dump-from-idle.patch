+// The IOP's SIF RPC client, as ps2sdk's IOP library has it (sifrpc.c). The
+// SifRpcClientData_t: hdr (pkt_addr, rpc_id, sema_id, mode: 16 bytes), command,
+// buf, cbuf, end_function, end_param, server (at 36).
+constexpr u32 kClientCommand = 16, kClientBuf = 20, kClientCbuf = 24, kClientServer = 36;
+constexpr u32 kSifRpcNoWait = 1;
+
+// sceSifBindRpc(client, sid, mode): the client takes the server a module
+// registered for `sid`; with none, server stays NULL and the caller waits
+// for one (the bind returns 0 either way, as the library's does).
+Outcome SifBindRpcClient(Vm& vm, Context& c) {
+    const u32 client = A(vm, c, 0), sid = A(vm, c, 1);
+    u32 server = 0, buffer = 0, cbuffer = 0;
+    for (const auto& [address, entry] : vm.rpc_servers)
+        if (entry.sid == sid) {
+            server = address;
+            buffer = entry.buffer;
+            cbuffer = entry.cbuffer;
+            break;
+        }
+    vm.Write(client + kClientCommand, 0, 4);
+    vm.Write(client + kClientBuf, buffer, 4);
+    vm.Write(client + kClientCbuf, cbuffer, 4);
+    vm.Write(client + kClientServer, server, 4);
+    if (!server) {
+        // The server is not there yet. The library's bind waits for the other
+        // side's answer, so the caller's loop must not spin: this thread waits a
+        // millisecond, and the rest of the system (the EE's answer to the load
+        // that started this module, the EE's registrations) runs before it asks again.
+        if (Thread* t = vm.Current()) {
+            t->until_us = vm.NowUs() + 1000;
+            Return(c, 0);
+            vm.Block(c, Wait::Delay, 0);
+            return Outcome::Block;
+        }
+    }
+    return Ret(c, 0);
+}
+
+// sceSifCallRpc(client, procedure, mode, send, ssize, recv, rsize, end, end_param).
+// A blocking call waits for the answer (its thread is woken from the server's);
+// the end function runs when the answer is in, as the library runs it.
+Outcome SifCallRpcClient(Vm& vm, Context& c) {
+    const u32 client = A(vm, c, 0), procedure = A(vm, c, 1), mode = A(vm, c, 2);
+    const u32 send = A(vm, c, 3), ssize = A(vm, c, 4), recv = A(vm, c, 5), rsize = A(vm, c, 6);
+    const u32 end_function = A(vm, c, 7), end_param = A(vm, c, 8);
+    const u32 server = vm.Read(client + kClientServer, 4);
+    const auto entry = vm.rpc_servers.find(server);
+    if (!server || entry == vm.rpc_servers.end()) return Ret(c, u32(-1));    // not bound
+    for (u32 i = 0; i < ssize; ++i) vm.Write(entry->second.buffer + i, vm.Read(send + i, 1), 1);
+    RpcRequest request;
+    request.procedure = procedure;
+    request.size = ssize;
+    request.receive = recv;
+    request.receive_size = rsize;
+    request.iop_client = true;
+    request.blocking = !(mode & kSifRpcNoWait);
+    request.client = vm.current;
+    request.client_gp = c.r[28];
+    request.end_function = end_function;
+    request.end_param = end_param;
+    IopRpcCall(vm, server, request);
+    if (!request.blocking) return Ret(c, 0);
+    if (!vm.Block(c, Wait::RpcReply, client)) return Ret(c, u32(KE_CAN_NOT_WAIT));
+    return Outcome::Block;
+}
+
+// The IOP file manager (ioman), for the disc: a module opens a disc file, reads
+// and seeks it, and closes it. A descriptor names an open file's bytes and
+// its position; ioman_open reads the whole file from the disc at once.
+struct OpenDiscFile {
+    std::vector<u8> bytes;
+    u32 pos = 0;
+};
+
+std::map<u32, OpenDiscFile>& OpenDiscFiles() {
+    static std::map<u32, OpenDiscFile> files;
+    return files;
+}
+
+u32& NextDiscFd() {
+    static u32 next = 3;                            // 0-2: the console's stdio
+    return next;
+}
+
+// ioman_open(name, flags, ...): "cdrom0:\\DIR\\FILE;1" as the SDK writes it.
+// A file the disc does not have is -2 (ENOENT); the trace names the file.
+Outcome IomanOpen(Vm& vm, Context& c) {
+    const u32 name = A(vm, c, 0);
+    std::string path;
+    for (u32 i = 0; i < 256; ++i) {
+        const char ch = char(vm.Read(name + i, 1));
+        if (!ch) break;
+        path += ch;
+    }
+    if (path.rfind("cdrom0:", 0) == 0) path = path.substr(7);
+    OpenDiscFile file;
+    if (!GuestDisc().IsOpen() || !GuestDisc().ReadFile(path, &file.bytes)) {
+        Note("iop open " + path, "IOP: open " + path + ": not on the disc");
+        return Ret(c, u32(-2));
+    }
+    const u32 fd = NextDiscFd()++;
+    Note("iop open " + path, "IOP: open " + path + " as descriptor " + std::to_string(fd) + " (" +
+                                 std::to_string(file.bytes.size()) + " bytes)");
+    OpenDiscFiles()[fd] = std::move(file);
+    return Ret(c, fd);
+}
+
+// iomanX_close(fd)
+Outcome IomanClose(Vm& vm, Context& c) {
+    const u32 fd = A(vm, c, 0);
+    if (!OpenDiscFiles().erase(fd)) return Ret(c, u32(-9));          // EBADF
+    return Ret(c, 0);
+}
+
+// iomanX_read(fd, buffer, size): the bytes left, at most size.
+Outcome IomanRead(Vm& vm, Context& c) {
+    const u32 fd = A(vm, c, 0), buffer = A(vm, c, 1), size = A(vm, c, 2);
+    auto found = OpenDiscFiles().find(fd);
+    if (found == OpenDiscFiles().end()) return Ret(c, u32(-9));
+    OpenDiscFile& file = found->second;
+    const u32 left = file.pos < file.bytes.size() ? u32(file.bytes.size()) - file.pos : 0;
+    const u32 n = std::min(size, left);
+    for (u32 i = 0; i < n; ++i) vm.Write(buffer + i, file.bytes[file.pos + i], 1);
+    file.pos += n;
+    return Ret(c, n);
+}
+
+// iomanX_lseek(fd, offset, whence): SEEK_SET 0, SEEK_CUR 1, SEEK_END 2.
+Outcome IomanLseek(Vm& vm, Context& c) {
+    const u32 fd = A(vm, c, 0);
+    const s32 offset = s32(A(vm, c, 1));
+    const u32 whence = A(vm, c, 2);
+    auto found = OpenDiscFiles().find(fd);
+    if (found == OpenDiscFiles().end()) return Ret(c, u32(-9));
+    OpenDiscFile& file = found->second;
+    const s64 base = whence == 0 ? 0 : whence == 1 ? s64(file.pos) : s64(file.bytes.size());
+    const s64 target = base + offset;
+    if (target < 0) return Ret(c, u32(-22));                          // EINVAL
+    file.pos = u32(target);
+    return Ret(c, file.pos);
+}
