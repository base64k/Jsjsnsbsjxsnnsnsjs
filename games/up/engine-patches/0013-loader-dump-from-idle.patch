+// An end function of an IOP sceSifCallRpc runs in a thread of its own (the
+// library runs it from the SIF's handler). A blocking caller waits for it.
+u32 StartHelper(Vm& vm, u32 entry, u32 arg, u32 gp) {
+    Thread t;
+    t.id = vm.next_id++;
+    t.helper = true;
+    t.entry = entry;
+    t.stack_size = 0x1000;
+    t.stack = vm.Allocate(t.stack_size);
+    if (!t.stack) return 0;
+    t.priority = 1;
+    t.c = Context{};
+    t.c.r[4] = arg;
+    t.c.r[28] = gp;
+    t.c.r[29] = t.stack + t.stack_size - 16;
+    t.c.r[31] = kThreadExit;
+    t.c.pc = entry;
+    t.c.npc = entry + 4;
+    t.wait = Wait::Dormant;
+    vm.threads[t.id] = t;
+    vm.MakeReady(vm.threads[t.id]);
+    return t.id;
+}
+
+// A blocked sceSifCallRpc returns 0 when its answer is in.
+void WakeRpcCaller(Vm& vm, u32 id) {
+    auto caller = vm.threads.find(id);
+    if (caller == vm.threads.end() || caller->second.wait != Wait::RpcReply) return;
+    caller->second.c.r[2] = 0;
+    vm.MakeReady(caller->second);
+}
+
+// The server's function returned for an IOP caller: its answer goes into the
+// caller's buffer; the end function runs, then the blocked caller returns.
+void IopRpcAnswer(Vm& vm, const RpcRequest& done, u32 answer) {
+    for (u32 i = 0; i < done.receive_size && done.receive && answer; ++i)
+        vm.Write(done.receive + i, vm.Read(answer + i, 1), 1);
+    if (done.end_function) {
+        const u32 helper = StartHelper(vm, done.end_function, done.end_param, done.client_gp);
+        if (helper && done.blocking) vm.threads[helper].wake_on_exit = done.client;
+        else if (!helper && done.blocking) WakeRpcCaller(vm, done.client);
+        return;
+    }
+    if (done.blocking) WakeRpcCaller(vm, done.client);
+}
+
+// Log-only probe: the module loader's thread, while its start has not returned.
+u32 g_probe_thread = 0;
+u32 g_loader_thread = 0;  // set at each module start, never cleared (for DumpLoaderPc)
+bool g_probe_done = false;
+std::chrono::steady_clock::time_point g_probe_start;
+
+void ProbeLoader(Vm& vm) {
+    if (!g_probe_thread || g_probe_done) return;
+    if (std::chrono::steady_clock::now() - g_probe_start < std::chrono::milliseconds(20)) return;
+    g_probe_done = true;
+    std::fprintf(stderr, "[host] PROBE: current thread %u, instructions %llu\n", unsigned(vm.current),
+                 (unsigned long long)vm.instructions);
+    for (const auto& [id, t] : vm.threads)
+        std::fprintf(stderr, "[host] PROBE thread %u: pc %08X ra %08X sp %08X wait %d ready %d\n", unsigned(id),
+                     unsigned(t.c.pc), unsigned(t.c.r[31]), unsigned(t.c.r[29]), int(t.wait), int(t.ready));
+    auto it = vm.threads.find(g_probe_thread);
+    if (it == vm.threads.end()) return;
+    const u32 pc = it->second.c.pc;
+    for (u32 a = pc - 0x100; a <= pc + 0x40; a += 4)
+        std::fprintf(stderr, "[host] PROBE DUMP %08X %08X\n", unsigned(a), unsigned(vm.Read(a, 4)));
+}
+
+// Log-only: the loader thread's pc and the code around it, from any thread.
+void DumpLoaderPc() {
+    if (!g_loader_thread) return;
+    Vm& vm = TheVm();
+    auto it = vm.threads.find(g_loader_thread);
+    if (it == vm.threads.end()) {
+        std::fprintf(stderr, "[host] LOADER: thread %u is gone\n", unsigned(g_loader_thread));
+        return;
+    }
+    const u32 pc = it->second.c.pc;
+    std::fprintf(stderr, "[host] LOADER: pc %08X ra %08X sp %08X wait %d ready %d (current thread %u)\n",
+                 unsigned(pc), unsigned(it->second.c.r[31]), unsigned(it->second.c.r[29]),
